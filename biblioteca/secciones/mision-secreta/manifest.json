        "title": {
          "es": "La misión",
          "en": "The mission"
        },
        "hint": {
          "es": "Quién la dirige, dónde estará el tesoro y el mensaje secreto del final.",
          "en": "Who leads it, where the treasure will be and the secret message at the end."
        },
        "fields": [
          "JEFE_MISION",
          "TEST_LUGAR",
          "TEST_RESULTADO"
        ]
      },
      "fieldDefs": {
        "JEFE_MISION": {
          "type": "name",
          "required": true,
          "cap": 14,
          "q": {
            "es": "¿Quién dirigirá la misión? (el adulto que tendrá las soluciones)",
            "en": "Who will lead the mission? (the adult who keeps the answers)"
          },
          "ej": {
            "es": "Mamá, Papá, Tía Carmen…",
            "en": "Mum, Dad, Aunt Carol…"
          },
          "corta": {
            "es": "Misión · Quién la dirige",
            "en": "Mission · Leader"
          }
        },
        "TEST_LUGAR": {
          "type": "text",
          "required": true,
          "cap": 26,
          "q": {
            "es": "¿Dónde esconderéis el tesoro? (el regalo, unas chuches…)",
            "en": "Where will you hide the treasure? (the present, some sweets…)"
          },
          "desc": {
            "es": "Los jugadores lo leerán al final. Escondedlo allí antes de empezar.",
            "en": "The players will read it at the end. Hide it there before you start."
          },
          "ej": {
            "es": "Dentro de la lavadora",
            "en": "Inside the washing machine"
          },
          "corta": {
            "es": "Misión · Escondite del tesoro",
            "en": "Mission · Treasure hiding place"
          }
        },
        "TEST_RESULTADO": {
          "type": "long",
          "required": true,
          "cap": 180,
          "q": {
            "es": "Mensaje secreto para quien cumple años",
            "en": "Secret message for the birthday child"
          },
          "desc": {
            "es": "Lo leerán al juntar las tiras del documento final.",
            "en": "They will read it when they put the strips of the final document together."
          },
          "ej": {
            "es": "¡Feliz cumpleaños, agente! Misión cumplida: eres el mejor equipo.",
            "en": "Happy birthday, agent! Mission accomplished: you are the best team."
          },
          "corta": {
            "es": "Misión · Mensaje secreto",
            "en": "Mission · Secret message"
          }
        }
