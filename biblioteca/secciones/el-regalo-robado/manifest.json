        "FAMA": {
          "type": "text",
          "required": true,
          "q": {
            "es": "¿Por qué se le conoce?",
            "en": "What are they known for?"
          },
          "cap": 24,
          "ej": {
            "es": "Por comer hamburguesas, por pillarse un pedo monumental cada vez que sale de fiesta…",
            "en": "For eating burgers, for getting wasted every time they go out…"
          },
          "corta": {
            "es": "El cumpleañero · Fama",
            "en": "The birthday person · Known for"
          }
        },
        "DEBILIDAD_TEXTO": {
          "type": "text",
          "required": true,
          "q": {
            "es": "Su mayor debilidad es",
