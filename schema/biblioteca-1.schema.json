{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pme-biblioteca/1",
  "title": "Manifiesto de una colección de la biblioteca (pme-biblioteca/1)",
  "description": "F2.1/F2.5 de PLAN-CREADOR-2.md. Tipos: «arte» (piezas), «pagina» (páginas v2 sin datos del comprador, con su fondo) y «seccion» (sección del formulario con sus campos y ejemplos) y «puzzle» (mecánica del catálogo con sus parámetros). Las reglas que el esquema no puede expresar están en tools/biblioteca/reglas.mjs y en validar.mjs (la página se valida contra pme-game-2).",
  "type": "object",
  "required": [
    "schema",
    "tipo",
    "pieces"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pme-biblioteca/1"
    },
    "tipo": {
      "enum": [
        "arte",
        "pagina",
        "seccion",
        "puzzle"
      ]
    },
    "pieces": {
      "type": "array"
    }
  },
  "$defs": {
    "pieza": {
      "type": "object",
      "required": [
        "id",
        "version",
        "file",
        "thumb",
        "name",
        "category",
        "tags",
        "widthMm",
        "heightMm",
        "zones",
        "license",
        "author",
        "origin"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string",
          "pattern": "^piezas/[^/]+\\.pdf$"
        },
        "thumb": {
          "type": "string",
          "pattern": "^piezas/[^/]+\\.png$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "fondo",
            "marco",
            "papel",
            "dispositivo",
            "objeto",
            "icono",
            "decoracion",
            "ilustracion",
            "puzzle"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-záéíóúñü0-9-]+$"
          }
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tipo",
              "x",
              "y",
              "w",
              "h"
            ],
            "additionalProperties": false,
            "properties": {
              "tipo": {
                "enum": [
                  "zona-foto",
                  "zona-texto"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "Licencia: la lista admitida está en tools/biblioteca/reglas.mjs (LICENCIAS_ARTE)."
        },
        "author": {
          "type": "string",
          "minLength": 2
        },
        "origin": {
          "type": "object",
          "minProperties": 1
        },
        "status": {
          "enum": [
            "ok",
            "reexportar"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "pagina": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "tags",
        "origin",
        "languages",
        "page",
        "i18n",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-záéíóúñü0-9-]+$"
          }
        },
        "origin": {
          "type": "object",
          "required": [
            "game",
            "page"
          ],
          "additionalProperties": false,
          "properties": {
            "game": {
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Versión del juego de origen (como en game.json)."
            },
            "page": {
              "type": "string"
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "page": {
          "type": "object"
        },
        "i18n": {
          "type": "object"
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "ok",
            "reexportar"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "La página (pme-game/2, con su fondo dentro) va en «page»; el tamaño, en el juego de origen."
    },
    "seccion": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "tags",
        "origin",
        "section",
        "fieldDefs",
        "examples"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-záéíóúñü0-9-]+$"
          }
        },
        "origin": {
          "type": "object",
          "required": [
            "game",
            "section"
          ],
          "additionalProperties": false,
          "properties": {
            "game": {
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "description": "Versión del juego de origen (como en game.json)."
            },
            "section": {
              "type": "string"
            }
          }
        },
        "section": {
          "type": "object",
          "required": [
            "id",
            "title",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "object"
            },
            "hint": {
              "type": "object"
            },
            "nameField": {
              "type": "string"
            },
            "photoField": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "fieldDefs": {
          "type": "object"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "values"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "values": {
                "type": "object"
              },
              "photos": {
                "type": "object"
              }
            }
          }
        },
        "status": {
          "enum": [
            "ok",
            "reexportar"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "puzzle": {
      "type": "object",
      "required": [
        "id",
        "version",
        "name",
        "tags",
        "origin",
        "kind",
        "mechanic",
        "params",
        "needs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^puzzle-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-záéíóúñü0-9-]+$"
          }
        },
        "origin": {
          "type": "object",
          "required": [
            "game",
            "mechanic",
            "page"
          ],
          "additionalProperties": false,
          "properties": {
            "game": {
              "type": "string"
            },
            "version": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "mechanic": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          }
        },
        "kind": {
          "enum": [
            "datos"
          ]
        },
        "mechanic": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "params": {
          "type": "object"
        },
        "needs": {
          "type": "array",
          "description": "Campos de la ficha que lee el puzzle (PLAN-CREADOR-2.md §2.3).",
          "items": {
            "type": "object",
            "required": [
              "field"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "derives": {
          "type": "array",
          "uniqueItems": true,
          "description": "Campos que calcula la mecánica (no se piden al comprador).",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
          }
        },
        "solution": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Cómo se resuelve, por idioma; {{CAMPO}} cuando depende del comprador."
        },
        "status": {
          "enum": [
            "ok",
            "reexportar"
          ]
        },
        "notes": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z]{2}$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "minAge": {
          "type": "integer",
          "minimum": 3
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "arte"
          }
        }
      },
      "then": {
        "properties": {
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pieza"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "pagina"
          }
        }
      },
      "then": {
        "properties": {
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pagina"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "seccion"
          }
        }
      },
      "then": {
        "properties": {
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/seccion"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "puzzle"
          }
        }
      },
      "then": {
        "properties": {
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/puzzle"
            }
          }
        }
      }
    }
  ]
}
